{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/burmjohn/boomi-project-documenter/visual-manifest.schema.json",
  "title": "Boomi Project Documenter visual manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "facts", "diagrams"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "evidence_date"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "evidence_date": {"type": "string", "format": "date"}
      }
    },
    "facts": {
      "type": "object",
      "required": [
        "component_versions",
        "inventory_counts",
        "risk_counts",
        "risks",
        "next_step_ids"
      ],
      "properties": {
        "component_versions": {"type": "array"},
        "inventory_counts": {"type": "object"},
        "risk_counts": {"type": "object"},
        "risks": {"type": "array"},
        "next_step_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {"$ref": "#/$defs/diagram"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "evidence_state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "source",
            "step",
            "decision",
            "target",
            "error",
            "subprocess",
            "system",
            "state"
          ]
        },
        "evidence_state": {
          "enum": ["configured", "observed", "inferred", "unverified", "historical"]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "label"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "from": {"$ref": "#/$defs/id"},
        "to": {"$ref": "#/$defs/id"},
        "label": {"type": "string"}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "orientation",
        "title",
        "description",
        "evidence_scope",
        "nodes",
        "edges"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"enum": ["context", "routing", "subprocess", "failure", "state"]},
        "orientation": {"enum": ["horizontal", "vertical"]},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "evidence_scope": {
          "enum": ["configuration", "observed-execution", "mixed"]
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "items": {"$ref": "#/$defs/node"}
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    }
  }
}
